# Database. Hosted Postgres: Vercel Postgres/Neon, or Supabase.
# Pooled connection string. Used by the running app.
DATABASE_URL=

# Direct (unpooled) connection string. Used only by `prisma migrate`.
# If your provider doesn't distinguish, set this to the same value as DATABASE_URL.
DIRECT_URL=

# Google Gemini.
# From https://aistudio.google.com/apikey . Pasted into Vapi's Google provider
# integration too, so the assistant bills against your free-tier key.
GEMINI_API_KEY=

# Vapi.
# Private API key from the Vapi dashboard (Settings -> API Keys).
VAPI_API_KEY=
# The id (a UUID, not the phone number itself) of the number you bought in Vapi.
VAPI_PHONE_NUMBER_ID=

# Public base URL of THIS deployment. Vapi calls back into it for tool calls.
# e.g. https://carecloud-patient-intake.vercel.app
PUBLIC_BASE_URL=

# Local dev only.
PORT=3000

# Set after the first `npm run agent:deploy` so re-runs update the same assistant.
VAPI_ASSISTANT_ID=
